# CJIS Applicant Tracker backend — example environment
# Copy to .env locally or on the app server. NEVER commit .env or real secrets.
# All values below are placeholders unless noted.

# --- HTTP API ---
# Always bind loopback. IIS reverse-proxies /api and /health (SPRINT-009).
# Do not set API_LISTEN_HOST to a public address.
API_LISTEN_HOST=127.0.0.1
API_LISTEN_PORT=8741

# Comma-separated browser origins allowed for CORS (in addition to localhost
# and https://clearancetracker.cabq.gov). Same-origin IIS proxy needs no CORS.
CORS_ALLOWED_ORIGINS=

# --- SQL Server / Azure SQL ---
# Create/refresh: sqlcmd -S <server> -E -i "CJISTracker\database-schema.sql"
# sql = SQL login (default). windows = NTLM using SQL_USER as DOMAIN\user plus SQL_PASSWORD.
# integrated = Windows integrated (trusted connection) as the API process identity.
# The Security & Authentication page saves integrated settings and does not send a password.
SQL_AUTHENTICATION=sql
SQL_SERVER=TBD
SQL_DATABASE=CjisApplicantTracker
SQL_USER=TBD
SQL_PASSWORD=TBD
SQL_DOMAIN=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
SQL_PORT=1433

# INTDEV example (replace TBD; do not commit real passwords):
# SQL_AUTHENTICATION=windows
# SQL_SERVER=COADTI-APD\APD
# SQL_DATABASE=TRACKERAPP_TEST
# SQL_USER=COA\svc-clearancetracker
# SQL_PASSWORD=<server-only>

# --- City SSO / Entra ID (DEC-015 / SPRINT-008) ---
# Production direction only. Do not implement live login against TBD values.
ENTRA_TENANT_ID=Needs to be Generated
ENTRA_CLIENT_ID=Needs to be Generated
ENTRA_CLIENT_SECRET=TBD
ENTRA_REDIRECT_URI=TBD
ENTRA_AUTHORIZE_URL=
ENTRA_TOKEN_URL=
ENTRA_ROLE_CLAIM=TBD

# --- SAML (recorded only; live login is not connected) ---
# Entity ID and Reply URL are for this application. Leave them unset until it is registered.
SAML_ENTITY_ID=TBD
SAML_REPLY_URL=TBD
SAML_SIGN_ON_URL=
SAML_RELAY_STATE=
SAML_LOGOUT_URL=
