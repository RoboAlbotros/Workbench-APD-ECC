# CJIS Applicant Tracker backend — example environment (SPRINT-007)
# Copy to .env locally. NEVER commit .env or real secrets.
# All values below are placeholders. Deployment target remains TBD.

# --- Localhost HTTP API (SPRINT-007) ---
# Bind 127.0.0.1 only. A public bind is excluded from this sprint.
API_LISTEN_HOST=127.0.0.1
API_LISTEN_PORT=8741

# --- SQL Server / Azure SQL ---
# Create the database first: sqlcmd -S <server> -E -i "CJISTracker\database-schema.sql"
# This prototype uses a SQL login (tedious / mssql). Windows Integrated auth is not wired.
SQL_SERVER=TBD
SQL_DATABASE=CjisApplicantTracker
SQL_USER=TBD
SQL_PASSWORD=TBD
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
SQL_PORT=1433

# --- SAML (owner direction 2026-10-23; live login is not connected) ---
# Entity ID and Reply URL are for this application. Leave them unset until it is registered.
# Do not use another application's SAML addresses.
SAML_ENTITY_ID=TBD
SAML_REPLY_URL=TBD
SAML_SIGN_ON_URL=
SAML_RELAY_STATE=
SAML_LOGOUT_URL=
# Identity-provider signing certificate and SSO URL stay on the server only. Do not commit them.
